<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BillMinderApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BillMinderApp"
    Shell.FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#3A51AC"
    Shell.TitleColor="White"

    Title="BillMinder">

    <Shell.FlyoutHeader>
        <VerticalStackLayout>
            <Label Text="Menu"
               FontAttributes="Bold"
               HeightRequest="50" 
               HorizontalTextAlignment="Center" 
               VerticalTextAlignment="Center"                   
               TextColor="White"
               FontSize="20">
            </Label>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <ShellContent
        Title="Home"
        Icon="home.png"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="About"
        Icon="about.png"
        ContentTemplate="{DataTemplate local:About}"
        Route="About" />

</Shell>
