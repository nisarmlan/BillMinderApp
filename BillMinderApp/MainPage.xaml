<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BillMinderApp.MainPage"
             Title="  "
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Label Text="Dashboard"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,10" />
                <!-- Buttons -->
                <Button Text="Add Bill"
                        WidthRequest="100"
                        HeightRequest="50"
                        BackgroundColor="#FF69B4"
                        TextColor="White"
                        FontAttributes="Bold" 
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Clicked="OnAddBillButtonClicked"/>
            </Grid>
            <!-- Next Bill Section -->
            <Frame BackgroundColor="#E8E8E8"
               CornerRadius="10"
               Padding="100"
               Margin="0,10">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label x:Name="nextBill"
                           Text="Next bill: RM"
                           FontSize="50"
                           FontAttributes="Bold"
                           TextColor="Black" />
                    <Label x:Name="dueDate"
                           Text="Due date:"
                           FontSize="25"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Bills List -->
            <CollectionView x:Name="displayRecord" ItemsSource="{Binding DueDate}" Margin="0,10">
                <CollectionView.ItemTemplate Clicked="OnAddBillButtonClicked">
                    <DataTemplate>
                        <VerticalStackLayout Spacing="5" Padding="5,0">
                            <!-- Bill Record -->
                            <Grid ColumnDefinitions="*,Auto"
                                  VerticalOptions="Center"
                                  Padding="0,5">
                                <!-- Bill Details -->
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding BillName}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="Black" />
                                    <Label Text="{Binding Category}"
                                            FontSize="14"
                                            TextColor="#A020F0" />
                                </VerticalStackLayout>

                                <!-- Amount and Due Date -->
                                <VerticalStackLayout Grid.Column="1" >
                                    <Label Text="{Binding Amount, StringFormat='RM {0:F2}'}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="Green" 
                                            HorizontalOptions="End"/>
                                    <Label Text="{Binding DueDate, StringFormat='Due Date: {0}'}"
                                            FontSize="12"
                                            TextColor="Gray"
                                            HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Divider -->
                            <BoxView HeightRequest="1"
                                      BackgroundColor="#E0E0E0"
                                      Margin="0,5" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
